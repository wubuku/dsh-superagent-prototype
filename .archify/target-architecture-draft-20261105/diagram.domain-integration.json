  "cards": [
    {
      "dot": "cyan",
      "title": "三类事实与写者",
      "items": [
        "制度事实：流程定义与实例，写者是流程引擎的定义仓库；实例钉住 definitionVersion（§19.2）",
        "认知事实：知识条目，写者是知识库，且只接受人工评审后的提案（§19.2、§21.2）",
        "运行事实：流程变量与 agent 运行状态；引擎变量或 RunStatePort 单写者（§19.2、§22）",
        "授权事实：Decision/Mandate/Ticket/receipt，只属于控制面账本（§19.2）"
      ]
    },
    {
      "dot": "rose",
      "title": "知识不授权（§21.4）",
      "items": [
        "Decision 平面与 Mandate 生成路径不得读取知识库",
        "AssessmentResult.evidence 只接受 source_event / mandate / policy_rule / prior_decision",
        "knowledge_ref 只能进 rationale、执行说明与报告；命中 evidence 即 unauthorized_evidence",
        "模块边界是第二道防线，协议白名单是强制闸门（§21.4、§21.4.1）"
      ]
    },
    {
      "dot": "amber",
      "title": "缺席与降级〔目标〕",
      "items": [
        "任一领域系统不可用，都不得阻塞 gate、Decision 写入与事件落库（§19.4）",
        "检索失败不得当成“没有相关规则”；空结果 ≠ 不可用（§19.4、§21.3）",
        "RunState 可整体丢弃重建，冲突时授权与工单以账本为准（§22.3、M4-6）",
        "〔待验证〕端口替换不改业务代码、恶意知识条目不影响判定（M4-7、M4-8）"
      ]
    }
